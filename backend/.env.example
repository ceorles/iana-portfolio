# --- Local development defaults (safe to leave as-is) ---
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180,http://localhost:5173,http://127.0.0.1:5173

# --- Production-only (set these in Render's dashboard, not here) ---
# DATABASE_URL is provided automatically if you attach a Render Postgres
# instance to this service. Leave unset locally to keep using SQLite.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# DEBUG=False
# SECRET_KEY=<Render can auto-generate this — see render.yaml>
# ALLOWED_HOSTS is auto-extended with RENDER_EXTERNAL_HOSTNAME (set
# automatically by Render), so you usually don't need to set this in prod.
# ALLOWED_HOSTS=

# CORS_ALLOWED_ORIGINS=https://your-frontend.onrender.com
# CSRF_TRUSTED_ORIGINS=https://your-backend.onrender.com

# Only needed if you attach a Render Persistent Disk for uploaded media
# (see the media-persistence note in the deployment summary).
# MEDIA_ROOT=/var/data/media

# Set to False only if you have a specific reason to disable the
# auto HTTPS redirect in production (Render already serves HTTPS by default).
# SECURE_SSL_REDIRECT=True
